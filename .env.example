# Backend API base URL (no trailing slash). Used when the user has not set one in the app.
# e.g. https://your-backend.example.com or http://192.168.1.100:8080
EXPO_PUBLIC_API_URL=

# When true, show the Orders tab. Set to false (default) when sharing with warehouse users.
EXPO_PUBLIC_SHOW_ORDERS_TAB=false

# When true, show verbose debug logs and errors on screen (e.g. Move SKU source scan)
EXPO_PUBLIC_SCREEN_DEBUG=false
